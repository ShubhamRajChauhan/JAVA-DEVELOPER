<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="myJpaUnit">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>  <!-- ye line clearly bolti hai application ko ki hum hibernate ka istemaal karenge -->
        <class>UserClassHibernate</class> <!-- same as your class name, agr aap ye class aap koi package mai move krte ho to ush package ke sath naam aana chaiye ish class ka -->

        <properties>
            <!-- ye properties database related and connection related hai -->
            <!-- aur hum yahan JPA related configuration set kr rhe hai -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/demo_db"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="password"/>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>

    </persistence-unit>

</persistence>