<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>

        <!-- Database connection -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/demo_db?useSSL=false&amp;serverTimeZone=UTC</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">password</property>

        <!-- Hibernate settings -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>
<!--        ye jo ddl(data definition query) queries hai , wo hum nhi likhenge wo hibernate generate karega
            ddl queries jishme hai insert, create , ye jo structure ko define krty hai table ke like alter, create
            to agr koi structural change aata hai aapki classes mai like humne new field add kr di to ye field database mai v add honi chaiye
            to ye database mai add honi chaiye ya nhi honi chaiye ye aap define kr rhe ho ish property ki help se
            to yahan aap keh rhe ho agr kuch v change hota hai classes mai to update or synchronize kr do database mai-->
        <property name="hibernate.hbm2ddl.auto">update</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
<!--        this property create one session per thread-->
        <property name="hibernate.current_session_context_class">thread</property>



        <!-- Mapping entity class -->
<!--        <mapping class="UserClassHibernate"/>-->

    </session-factory>

</hibernate-configuration>